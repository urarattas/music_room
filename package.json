{
  "name": "music-room",
  "version": "0.2.0",
  "private": true,
  "description": "在线多人音乐听歌房：浏览器直连 GD Studio 音乐台 API，用户之间 WebRTC P2P 语音 + 文字聊天",
  "type": "module",
  "main": "server/index.js",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-timeout=30000 test/",
    "test:ws": "node --test --test-timeout=15000 test/websocket.test.js",
    "test:lyrics": "node --test test/lyrics.test.js",
    "test:resilience": "node test/resilience.test.js",
    "test:docker": "node --test test/docker.test.js",
    "test:docker:ignore": "node --test test/dockerignore.test.js",
    "test:docker:npm": "node --test test/docker-npm.test.js",
    "test:docker:runtime": "node test/docker-runtime.test.js",
    "test:docker:e2e": "node test/docker-e2e.mjs",
    "test:shutdown": "node --test --test-timeout=20000 test/shutdown.test.js",
    "test:logger": "node --test test/logger.test.js",
    "test:logger:e2e": "node test/logger-e2e.mjs",
    "test:cleanup": "node test/room-cleanup.test.js",
    "test:docs": "node --test test/docs.test.js",
    "test:workflow": "node --test test/workflow.test.js",
    "test:metadata": "node --test test/metadata-action.test.js",
    "test:ui": "node test/ui.test.js",
    "test:ui:fixes": "node test/ui-fixes.test.js",
    "test:scrollbar": "node test/scrollbar.test.js",
    "test:sources": "node test/sources.test.js",
    "screenshot": "node test/screenshot.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "puppeteer-core": "^25.14.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "webrtc",
    "music",
    "chat",
    "websocket"
  ],
  "license": "MIT"
}
